# ---------------------------------------------------------------- profile

PROFILE_DIR = ROOT / "TMessagesProj_App" / "src" / "main" / "generated" / "baselineProfiles"
PROFILE_HAND = ROOT / "TMessagesProj_App" / "src" / "main" / "baseline-prof.txt"


def line_count(path: Path) -> int:
    return sum(1 for line in path.read_text().splitlines() if line.strip() and not line.startswith("#")) if path.exists() else 0


def cmd_profile(a: argparse.Namespace) -> None:
    """Run the baselineprofile generator (:baselineprofile) against the running, logged-out emulator."""
    disk_guard()
    adb = shutil.which("adb") or str(sdk_root() / "platform-tools/adb")
    env = base_env()
    secret_env(env, release=False)
    if a.serial:
        env["ANDROID_SERIAL"] = a.serial
    devices = subprocess.run([adb, "devices"], capture_output=True, text=True, env=env).stdout.splitlines()[1:]
    online = [d.split()[0] for d in devices if d.strip().endswith("device")]
    if not online:
        die("no running emulator/device; start the AVD (nanogram-api36-16k) first")
    if len(online) > 1 and not a.serial:
        die(f"several devices ({', '.join(online)}); pass --serial")
    env["ORG_GRADLE_PROJECT_nanogramBuildNumber"] = build_number(None)
    env["ORG_GRADLE_PROJECT_nanogramAbis"] = "arm64"
    pre = cmd_prebuild(argparse.Namespace(abis="arm64", force=False))
    env["ORG_GRADLE_PROJECT_nanogramPrebuildDir"] = str(pre)
    log = LOGS / "profile.log"
    t0 = time.time()
    rc = gradlew([":TMessagesProj_App:generateBaselineProfile", "-Pnanogram.baselineProfile=true"], env, log)
    secs = time.time() - t0
    record("profile" if rc == 0 else "profile-FAILED", secs, {})
    if rc != 0:
        die(f"profile generation failed (exit {rc}); log {log}")
    # The plugin saves into src (saveInSrc); fall back to its build output if it did not.
    if not (PROFILE_DIR / "baseline-prof.txt").exists():
        found = sorted((ROOT / "TMessagesProj_App" / "build").rglob("baseline-prof.txt"), key=lambda p: p.stat().st_mtime)
        found = [p for p in found if "generated" not in p.parts and "baselineProfile" in str(p)]
        if not found:
            die("generation finished but no baseline-prof.txt was produced")
        PROFILE_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy2(found[-1], PROFILE_DIR / "baseline-prof.txt")
    gen = line_count(PROFILE_DIR / "baseline-prof.txt")
    startup = line_count(PROFILE_DIR / "startup-prof.txt")
    hand = line_count(PROFILE_HAND)
    info(f"generated baseline-prof.txt {gen} lines, startup-prof.txt {startup} lines, hand-written {hand} lines ({secs:.0f}s)")
    info(f"review and commit {PROFILE_DIR.relative_to(ROOT)}")


def dir_size(p: Path) -> int:
    total = 0
    for root, _, files in os.walk(p):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def cmd_prune(a: argparse.Namespace) -> None:
    before = free_gb()
    env = base_env()
    if shutil.which("ccache"):
        info(f"ccache cap {TC.get('ccache.maxsize', '8G')}")
        if not a.dry_run:
            subprocess.call(["ccache", "-M", TC.get("ccache.maxsize", "8G")], env=env, stdout=subprocess.DEVNULL)
            subprocess.call(["ccache", "--evict-older-than", "30d"], env=env, stdout=subprocess.DEVNULL)
    # Prebuild cache: keep the key for HEAD plus the two newest others.
    pre = CACHE / "prebuild"
    if pre.exists():
        current = {prebuild_key(prebuild_abis("arm64")), prebuild_key(prebuild_abis("all"))}
        for p in pre.glob("*.tmp"):
            info(f"remove failed prebuild {p.name}")
            if not a.dry_run:
                shutil.rmtree(p, ignore_errors=True)
        others = sorted((p for p in pre.iterdir() if p.name not in current and not p.name.endswith(".tmp")), key=lambda p: p.stat().st_mtime, reverse=True)
        for p in others[2:]:
            info(f"remove prebuild {p.name} ({dir_size(p) / 1e9:.1f} GB)")
            if not a.dry_run:
                shutil.rmtree(p, ignore_errors=True)
    # Build outputs: keep the newest five builds.
    if OUT.exists():
        builds = sorted((p for p in OUT.iterdir() if p.is_dir()), key=lambda p: p.name, reverse=True)
        for p in builds[5:]:
            info(f"remove build-output/{p.name}")
            if not a.dry_run:
                shutil.rmtree(p, ignore_errors=True)
    # Stale CMake trees for configurations other than the newest per build type.
    cxx = ROOT / "TMessagesProj/.cxx"
    for bt in (cxx.iterdir() if cxx.exists() else []):
        trees = sorted((p for p in bt.iterdir() if p.is_dir()), key=lambda p: p.stat().st_mtime, reverse=True)
        for p in trees[1:]:
            info(f"remove .cxx/{bt.name}/{p.name} ({dir_size(p) / 1e9:.1f} GB)")
            if not a.dry_run:
                shutil.rmtree(p, ignore_errors=True)
    if a.max_gb:
        size = dir_size(CACHE) / 1e9
        info(f"cache {CACHE} is {size:.1f} GB (cap {a.max_gb} GB)")
    info(f"free disk {before:.1f} -> {free_gb():.1f} GB")


def cmd_metrics(_: argparse.Namespace) -> None:
    print(METRICS.read_text() if METRICS.exists() else "no metrics yet")


def main() -> None:
    ap = argparse.ArgumentParser(prog="ng", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)
    sub.add_parser("setup").set_defaults(fn=cmd_setup)
    p = sub.add_parser("prebuild")
    p.add_argument("--abis", choices=["arm64", "all"], default=None)
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_prebuild)
    p = sub.add_parser("build")
    p.add_argument("variant", nargs="?", choices=["debug", "release"], default="debug")
    p.add_argument("--abis", choices=["arm64", "all"], default=TC.get("abis", "arm64"))
    p.add_argument("--build-number")
    p.add_argument("--task", help="Gradle task to run instead of the default assemble task")
    p.add_argument("--clean", action="store_true")
    p.add_argument("--no-cache", action="store_true", help="disable Gradle build and configuration caches")
    p.add_argument("--upstream-prebuilts", action="store_true", help="use the committed upstream prebuilt libraries")
    p.set_defaults(fn=cmd_build)
    p = sub.add_parser("install")
    p.add_argument("apk", nargs="?")
    p.set_defaults(fn=cmd_install)
    p = sub.add_parser("release")
    p.add_argument("--notes", required=True, help="short public notes file (which areas improved, never how)")
    p.add_argument("--private-notes", help="detailed notes file; default: matching CHANGELOG.md section")
    p.add_argument("--build-number")
    p.add_argument("--skip-build", action="store_true", help="reuse build-output/<build number>")
    p.add_argument("--dry-run", action="store_true", help="do everything except the gh calls (print them)")
    p.set_defaults(fn=cmd_release)
    p = sub.add_parser("signing")
    p.add_argument("action", choices=["init"])
    p.set_defaults(fn=cmd_signing)
    sub.add_parser("check").set_defaults(fn=cmd_check)
    p = sub.add_parser("profile")
    p.add_argument("--serial", help="adb serial when several devices are connected")
    p.set_defaults(fn=cmd_profile)
    p = sub.add_parser("prune")
    p.add_argument("--max-gb", type=float)
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_prune)
    sub.add_parser("metrics").set_defaults(fn=cmd_metrics)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
